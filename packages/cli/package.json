{
  "name": "@magicdian/transpec",
  "version": "2604.9.5",
  "type": "module",
  "description": "Universal spec conversion tool",
  "main": "dist/index.js",
  "bin": {
    "transpec": "./bin/transpec.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node -e \"const fs=require('fs');const path=require('path');function copyDir(s,d){fs.mkdirSync(d,{recursive:true});for(const e of fs.readdirSync(s)){const sp=path.join(s,e),dp=path.join(d,e);fs.statSync(sp).isDirectory()?copyDir(sp,dp):fs.copyFileSync(sp,dp);}};copyDir('.transpec','dist/.transpec');\"",
    "prepublish": "npm run build",
    "test": "vitest"
  },
  "keywords": [
    "spec",
    "conversion",
    "openspec",
    "trellis"
  ],
  "author": "jingd2",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.0",
    "ora": "^7.0.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
