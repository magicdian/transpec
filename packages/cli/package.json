{
  "name": "@magicdian/transpec",
  "version": "2604.18.1",
  "type": "module",
  "description": "Universal spec conversion framework CLI with a production-ready OpenSpec to Trellis workflow",
  "main": "dist/cli/index.js",
  "types": "dist/cli/index.d.ts",
  "bin": {
    "transpec": "./bin/transpec.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README_CN.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc && npm run copy-assets",
    "copy-assets": "node ./scripts/copy-skill-assets.cjs",
    "prepublishOnly": "npm run build",
    "test": "vitest"
  },
  "keywords": [
    "spec",
    "cli",
    "conversion",
    "migration",
    "openspec",
    "trellis",
    "ai-agent",
    "agent-workflow"
  ],
  "author": "jingd2",
  "license": "Apache-2.0",
  "homepage": "https://github.com/magicdian/transpec#readme",
  "bugs": {
    "url": "https://github.com/magicdian/transpec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicdian/transpec.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.0",
    "ora": "^7.0.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
